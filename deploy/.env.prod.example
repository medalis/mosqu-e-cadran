# Nidaa — configuration du pilote. Copier vers deploy/.env puis remplacer TOUTES les valeurs « CHANGER ».
#   cp .env.prod.example .env && chmod 600 .env
# Ce fichier est lu par docker compose (substitution dans docker-compose.prod.yml) et par backup.sh.

# --- Domaines (enregistrements DNS A/AAAA pointant vers la VM, voir README) ---
DOMAIN_WEB=nidaa.dj
DOMAIN_API=api.nidaa.dj
DOMAIN_ADMIN=admin.nidaa.dj
DOMAIN_SCREEN=ecran.nidaa.dj
# « www.${DOMAIN_WEB} » est redirigé vers ${DOMAIN_WEB} : prévoir aussi son enregistrement DNS.

# Adresse de contact pour Let's Encrypt (alertes d'expiration de certificat)
ACME_EMAIL=CHANGER@exemple.dj

# --- Secrets (générer chacun avec : openssl rand -hex 32) ---
# Hexadécimal uniquement pour le mot de passe PostgreSQL : il est inséré dans DATABASE_URL.
POSTGRES_PASSWORD=CHANGER-openssl-rand-hex-32
# Signature des jetons d'accès du back-office.
JWT_SECRET=CHANGER-openssl-rand-hex-32
# Jeton partagé entre le site public et l'API (exempte le serveur du site de la limite de débit publique).
INTERNAL_API_TOKEN=CHANGER-openssl-rand-hex-32

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- API ---
# Origines autorisées pour les routes authentifiées (/v1/auth, /v1/me, /v1/admin, /v1/super, /v1/screen) :
# le back-office et l'écran. Les routes publiques en lecture (/v1/mosques*, /v1/time) sont ouvertes à toute origine.
CORS_ORIGINS=https://${DOMAIN_ADMIN},https://${DOMAIN_SCREEN}
# Documentation Swagger sur /docs : désactivée en production.
SWAGGER_ENABLED=false
# Limite de débit des routes publiques, en requêtes par minute et par IP.
PUBLIC_RATE_LIMIT=120
# Migrations au démarrage de l'API : prisma (défaut) | psql (repli sans moteur Prisma) | none
MIGRATE_MODE=prisma
# Mettre 1 pour construire l'image API sans accès à binaries.prisma.sh (impose alors MIGRATE_MODE=psql).
PRISMA_OFFLINE=

# --- Photos ---
# local (défaut) : fichiers dans le volume Docker « api_media », servis par l'API (https://${DOMAIN_API}/v1/files/…).
#                  backup.sh ne sauvegarde PAS ce volume : le copier à part (voir README, « Sauvegardes »).
# supabase       : Supabase Storage (compartiment public) ; renseigner alors les trois variables suivantes.
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=nidaa-media

# --- URL publiques figées dans les applications à la compilation (reconstruire les images après modification) ---
NEXT_PUBLIC_API_URL=https://${DOMAIN_API}
NEXT_PUBLIC_SITE_URL=https://${DOMAIN_WEB}
NEXT_PUBLIC_SCREEN_URL=https://${DOMAIN_SCREEN}

# --- Sauvegardes (backup.sh) ---
BACKUP_DIR=/var/backups/nidaa
BACKUP_KEEP_DAYS=14
