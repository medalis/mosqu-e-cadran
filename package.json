{
  "name": "nidaa",
  "private": true,
  "version": "0.1.0",
  "description": "Nidaa — plateforme de mosquée connectée (horaires de prière réels, écran de salle, back-office, page publique)",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:up": "docker compose up -d postgres redis",
    "db:migrate": "pnpm --filter @nidaa/api prisma:migrate",
    "db:seed": "pnpm --filter @nidaa/api prisma:seed",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.11.7",
    "typescript": "^5.9.3"
  }
}
