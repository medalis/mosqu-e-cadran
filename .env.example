# API
DATABASE_URL=postgresql://nidaa:nidaa@localhost:5432/nidaa
# Migrations Prisma. En local : identique à DATABASE_URL (les scripts pnpm prisma:* le font seuls s'il est absent).
# Sur Supabase : DATABASE_URL = pooler « transaction » (port 6543, ?pgbouncer=true), DIRECT_URL = pooler « session » (port 5432).
DIRECT_URL=postgresql://nidaa:nidaa@localhost:5432/nidaa
# Pool de connexions (défaut 5). TLS automatique dès que l'hôte n'est pas local ; certificat vérifié par défaut.
#DB_POOL_MAX=5
#DB_SSL_CA=                 # autorité de certification (contenu PEM) — ou DB_SSL_CA_FILE=/chemin/ca.crt
#DB_SSL_NO_VERIFY=false     # true : chiffre sans vérifier le certificat (à éviter)
#DB_SSL=                    # true/false pour forcer ou couper le TLS
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
PUBLIC_WEB_URL=http://localhost:3000
# CORS_ORIGINS ne concerne que les routes authentifiées ; /v1/mosques* et /v1/time sont ouvertes à toute origine.
# Swagger /docs : actif par défaut en développement, désactivé si NODE_ENV=production (forcer avec true/false).
#SWAGGER_ENABLED=true
# Nombre de reverse proxies devant l'API (IP réelle du client pour la limite de débit) et limite publique par minute et par IP.
#TRUST_PROXY=1
#PUBLIC_RATE_LIMIT=120
# Stockage des photos : local (fichiers sous STORAGE_LOCAL_DIR, servis par l'API sur /v1/files/*) ou supabase.
STORAGE_DRIVER=local
#STORAGE_LOCAL_DIR=storage            # relatif à apps/api
#PUBLIC_API_URL=http://localhost:4000 # URL publique de l'API : préfixe des URL de photos du pilote local
# Pilote supabase (voir deploy/supabase/README.md). La clé de service reste côté serveur : jamais en NEXT_PUBLIC_* / VITE_*.
#SUPABASE_URL=https://<ref>.supabase.co
#SUPABASE_SERVICE_ROLE_KEY=
#STORAGE_BUCKET=nidaa-media
# Jeton partagé API ↔ site public : exempte le serveur du site de la limite de débit (facultatif en développement).
#INTERNAL_API_TOKEN=

# Back-office (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Site public (Next.js, port 3001) — API_URL (serveur) prime sur NEXT_PUBLIC_API_URL
API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Écran (Vite)
VITE_API_URL=http://localhost:4000
